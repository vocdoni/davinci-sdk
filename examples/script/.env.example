# Sequencer node URLs of the deployment, comma-separated. Ask its operators:
# they are never built into the SDK.
DAVINCI_NODES=https://sequencer-1.example.org,https://sequencer-2.example.org

# JSON-RPC of the network (Gnosis): organizer transactions and chain reads.
RPC_URL=https://rpc.example.org

# The organizer's private key: it creates the elections and pays their gas.
PRIVATE_KEY=

# Where census files and metadata documents are published. They must be
# served unchanged over public https, with no redirect. Either a directory a
# web server serves at PUBLISH_URL:
PUBLISH_DIR=
PUBLISH_URL=
# or an HTTP PUT to UPLOAD_URL/<name>, served at PUBLIC_URL/<name>:
UPLOAD_URL=
PUBLIC_URL=

# election.ts: merkle (a census file) or csp (a CSP's signatures).
CENSUS=merkle
# election.ts: sequencer, dkg or dkg-locked.
KEY_MODE=sequencer
# election.ts: how many voters to draw.
VOTERS=3
# election.ts with CENSUS=csp: the CSP's key (random when empty).
CSP_PRIVATE_KEY=

# onchain.ts: an OwnedCensus the organizer owns; one is deployed when empty.
CENSUS_CONTRACT=

# Optional: read the ballot circuit files from a local directory (they are
# checked against their pinned sha256 either way).
ARTIFACTS_DIR=

# Local development only: accept documents on loopback and private hosts.
ALLOW_PRIVATE_HOSTS=false

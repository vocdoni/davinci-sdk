# Settings of the anvil suite (`yarn test:anvil`). Copy to test/.env; every
# variable is optional.

# Checkouts of davinci-contracts and davinci-onchain-census-contract (with
# submodules). Default: shallow clones of the commits the vendored ABIs come
# from, made once under DAVINCI_ANVIL_CACHE.
# DAVINCI_CONTRACTS_DIR=../davinci-contracts
# DAVINCI_CENSUS_CONTRACT_DIR=../davinci-onchain-census-contract

# Clones, forge output and the anvil log, used by one run at a time (a second
# run waits). Default: ~/.cache/davinci-sdk-anvil
# DAVINCI_ANVIL_CACHE=

# Directory holding forge and anvil. Default: ~/.foundry/bin, else PATH
# FOUNDRY_BIN=

# Settings of the live Gnosis suite (`yarn test:e2e`, see test/e2e/README.md).
# Unset DAVINCI_SDK_E2E skips it; scripts/e2e-live.sh sets it and the paths.
# DAVINCI_SDK_E2E=prepare
# Private directory of the voter keys (never inside the repository).
# Default: ~/.davinci-gnosis/sdk-e2e
# DAVINCI_SDK_E2E_DIR=
# Circuit files kept between runs. Default: ~/.cache/davinci-sdk-e2e/artifacts
# DAVINCI_SDK_E2E_ARTIFACTS=
# The run phase: the fixtures at a pushed commit, the node URLs and the
# organizer's key file (read by path, never printed).
# DAVINCI_SDK_E2E_BASE_URL=https://raw.githubusercontent.com/vocdoni/davinci-sdk/<commit>/test/e2e/fixtures
# DAVINCI_E2E_NODES=https://node-1.example.org,https://node-2.example.org
# DAVINCI_E2E_ORGANIZER_KEY=/path/to/organizer.key
# Gnosis JSON-RPCs tried before the preset ones, comma-separated. Optional.
# DAVINCI_E2E_RPC=

# Settings of the anvil suite (`yarn test:anvil`). Copy to test/.env; every
# variable is optional.

# Checkouts of davinci-contracts and davinci-onchain-census-contract (with
# submodules). Default: shallow clones of the commits the vendored ABIs come
# from, made once under DAVINCI_ANVIL_CACHE.
# DAVINCI_CONTRACTS_DIR=../davinci-contracts
# DAVINCI_CENSUS_CONTRACT_DIR=../davinci-onchain-census-contract

# Clones, forge output and the anvil log, used by one run at a time (a second
# run waits). Default: ~/.cache/davinci-sdk-anvil
# DAVINCI_ANVIL_CACHE=

# Directory holding forge and anvil. Default: ~/.foundry/bin, else PATH
# FOUNDRY_BIN=

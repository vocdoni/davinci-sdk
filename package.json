{
  "name": "@vocdoni/davinci-sdk",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && rollup -c",
    "dev": "rollup -c -w",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint-staged": "lint-staged",
    "sync:abis": "node scripts/sync-abis.mjs",
    "test": "yarn test:unit && yarn test:anvil",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:anvil": "vitest run --config vitest.anvil.config.ts",
    "test:contracts": "vitest run --config vitest.unit.config.ts test/contracts",
    "test:sequencer": "vitest run --config vitest.unit.config.ts test/sequencer",
    "test:census": "vitest run --config vitest.unit.config.ts test/census",
    "test:core": "vitest run --config vitest.unit.config.ts test/core",
    "test:crypto": "vitest run --config vitest.unit.config.ts test/crypto"
  },
  "description": "A powerful TypeScript SDK for building decentralized voting applications on the Vocdoni DaVinci protocol with homomorphic encryption and zero-knowledge proofs",
  "keywords": [
    "vocdoni",
    "davinci",
    "voting",
    "blockchain",
    "ethereum",
    "decentralized",
    "privacy",
    "homomorphic-encryption",
    "zero-knowledge",
    "zk-snarks",
    "typescript",
    "sdk",
    "elections",
    "governance",
    "cryptography",
    "web3"
  ],
  "author": {
    "name": "Vocdoni",
    "email": "info@vocdoni.io",
    "url": "https://vocdoni.io"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "homepage": "https://github.com/vocdoni/davinci-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vocdoni/davinci-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/vocdoni/davinci-sdk/issues"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "circomlibjs": "^0.1.7",
    "ethers": "^6.7.1",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/node": "^20.5.9",
    "@typescript-eslint/eslint-plugin": "^6.6.0",
    "@typescript-eslint/parser": "^6.6.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.2",
    "eslint": "^8.48.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "rollup": "^4.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "typescript": "^5.2.2",
    "vitest": "^4.0.18"
  }
}
